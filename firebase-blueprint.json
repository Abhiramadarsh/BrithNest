{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A product for sale in the BritNest store.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string", "enum": ["Energy-saving", "Sustainable Homeware", "Pet Products", "Decor", "Garden", "Fragrance"] },
        "image": { "type": "string" },
        "energyRating": { "type": "string", "enum": ["A", "B", "C", "D", "E"] },
        "madeInBritain": { "type": "boolean" },
        "isEnergySaver": { "type": "boolean" },
        "carbonFootprint": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "stock": { "type": "number" }
      },
      "required": ["name", "price", "category", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object" } },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "shipped", "delivered"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "total", "status"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "An article or guide.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content"]
    }
  },
  "firestore": {
    "products": {
      "schema": "Product",
      "description": "Collection of products available for purchase."
    },
    "orders": {
      "schema": "Order",
      "description": "Historical customer orders."
    },
    "blog": {
      "schema": "BlogPost",
      "description": "Lifestyle and energy-saving guides."
    }
  }
}
